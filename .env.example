ANDROMEDA_AUTH_SERV_URL=https://auth.example.com/andromeda
ANDROMEDA_AUTH_SERV_TEST_URL=https://auth-test.example.com/andromeda
APP_JWT_SECRET=<BASE64_ENCODED_JWT_SECRET>
APP_RESOURCES_BASE_URL=https://cdn.example.com/resources/nebula/
CORS_ALLOWED_ORIGIN_PATTERNS=https://app.example.com,https://*.app.example.com
HEADER_FOR_AUTH_SERVER=nebula-rest-api
IMAGE_AVATAR_PATH=/srv/nebula/avatars
NEBULA_DB_URL=jdbc:mariadb://db.example.internal:3306/nebula
NEBULA_USERNAME=<NEBULA_DB_USERNAME>
NEBULA_PASSWORD=<NEBULA_DB_PASSWORD>
NEBULA_TEST_DB_URL=jdbc:mariadb://db-test.example.internal:3306/nebula_test
NEBULA_TEST_USERNAME=<NEBULA_TEST_DB_USERNAME>
NEBULA_TEST_PASSWORD=<NEBULA_TEST_DB_PASSWORD>

# ci/hub-report.sh (milkyway-hub's ci-templates/spring-maven/) -- also stored as
# GitHub Actions repo secrets (Settings -> Secrets and variables -> Actions).
# HUB_URL is not sensitive on its own -- the Hub's public HTTPS address, reachable
# from the self-hosted test runner the same way a browser reaches it.
HUB_URL=https://milkyway.test/hub
# Component bearer token for nebula/rest/nebula-rest-api. Mint it from the Hub UI:
# component screen -> "API tokens" button (shown once on creation), or
# POST /api/v1/components/{id}/tokens. Never share the real value.
HUB_CI_TOKEN=hubci_replace_with_a_real_token
# milkyway.test's cert is self-signed -- pin it instead of curl -k.
HUB_CACERT=/path/to/milkyway.crt
